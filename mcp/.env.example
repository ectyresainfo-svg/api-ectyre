# URL base de la API REST de Ectyre (con /api/v1, sin barra final)
API_BASE_URL=https://ectyre-backend.vercel.app/api/v1
# Token secreto que n8n enviará como "Authorization: Bearer <token>". Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_TOKEN=
# Opcional: dominio de la tienda para incluir enlaces a los productos
STORE_URL=
# Opcional
MAX_RESULTS=10
API_TIMEOUT_MS=15000
# Solo pruebas locales (NUNCA en producción)
ALLOW_NO_AUTH=false
